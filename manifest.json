{
  "manifest_version": 3,
  "name": "Cock Token Extractor",
  "version": "1.0",
  "description": "Easily copy your Discord account token.",
  "permissions": [
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "*://*.discord.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}